# Environment variables template
# Copy this to .env and fill in your values

# ── Database ─────────────────────────────────────────────────
# For local development:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitness_db

# For Render (set this in the Render dashboard, not here):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-byte-string

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── TOTP ─────────────────────────────────────────────────────
TOTP_ISSUER_NAME=FitnessApp

# ── Password Reset ───────────────────────────────────────────
RESET_TOKEN_EXPIRE_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# CORS_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]
